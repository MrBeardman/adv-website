---
import '../styles/fonts.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/ui/Consent.astro';
import { LANGS, langInfo, pick, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import { INDEXABLE, EM_STYLE } from '../data/site';
import { orgSchema, websiteSchema } from '../data/seo';
// hashed under /_astro/ so the host serves them with a one-year immutable cache
import urbanist600 from '../assets/fonts/urbanist-latin-600-normal.woff2?url';
import manrope400 from '../assets/fonts/manrope-latin-400-normal.woff2?url';
import urbanist600Ext from '../assets/fonts/urbanist-latin-ext-600-normal.woff2?url';
import manrope400Ext from '../assets/fonts/manrope-latin-ext-400-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page in every language that has it, e.g. { cs: '/', en: '/en/' } */
  alternates: Partial<Record<Lang, string>>;
  ogImage?: string;
  /** Draw the stream of light through this page (needs [data-node] kickers, see scripts/stream.ts). */
  stream?: boolean | 'light';
  /** The page is a workflow canvas: sections in ui/NodeFrame.astro, wired by scripts/canvas.ts. */
  canvas?: boolean;
  /** the hero's lines drift behind the page as a slow helix (scripts/flow/drift.ts); on by default */
  drift?: boolean;
  noindex?: boolean;
  /** extra schema.org nodes for this page's JSON-LD graph (Service, BreadcrumbList; see data/seo.ts) */
  schema?: Record<string, unknown>[];
}
const {
  lang,
  title,
  description,
  alternates,
  ogImage = '/media/cases/kesia/cover.webp',
  stream = false,
  canvas = false,
  drift = true,
  noindex = false,
  schema = [],
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(alternates[lang] ?? Astro.url.pathname, site).href;
const info = langInfo(lang);
const t = pick(chrome, lang);
// The page's JSON-LD graph: the company and the site on every page, plus what the page adds (docs/GEO.md).
const graph = {
  '@context': 'https://schema.org',
  '@graph': [orgSchema(lang, site), websiteSchema(lang, site), ...schema],
};
---

<!doctype html>
<html lang={info.code} class="no-js" data-em={EM_STYLE === 'ice' ? undefined : EM_STYLE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Preview phase: the whole site is noindex until the launch switch in data/site.ts is flipped. */}
    {
      !INDEXABLE ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        noindex && <meta name="robots" content="noindex" />
      )
    }
    {
      LANGS.filter((l) => alternates[l.code]).map((l) => (
        <link rel="alternate" hreflang={l.code} href={new URL(alternates[l.code]!, site).href} />
      ))
    }
    {alternates.cs && <link rel="alternate" hreflang="x-default" href={new URL(alternates.cs, site).href} />}
    <meta property="og:locale" content={info.og} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ADV Innovations" />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#06070b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={urbanist600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin />
    {
      lang === 'cs' && (
        <>
          <link rel="preload" href={urbanist600Ext} as="font" type="font/woff2" crossorigin />
          <link rel="preload" href={manrope400Ext} as="font" type="font/woff2" crossorigin />
        </>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class:list={[{ 'is-canvas': canvas, 'is-drift': drift }]}>
    <a class="skip-link screen-reader-text" href="#content">{t.nav.skip}</a>
    <div class="adv-bg" aria-hidden="true">
      <div class="adv-bg__mood adv-bg__mood--top"></div>
      <div class="adv-bg__mood adv-bg__mood--mid"></div>
      <div class="adv-bg__mood adv-bg__mood--end"></div>
      <div class="adv-bg__grain"></div>
      <div class="adv-bg__vignette"></div>
    </div>
    {drift && <canvas class="adv-drift" data-drift aria-hidden="true" />}
    <div class="adv-progress" aria-hidden="true"></div>
    <Header lang={lang} alternates={alternates} />
    <main id="content">
      {canvas && <div class="adv-canvas" data-canvas aria-hidden="true" />}
      {stream && <div class="adv-stream" data-stream={stream === 'light' ? 'light' : ''} aria-hidden="true" />}
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
    <Consent lang={lang} />
    <script>
      import '../scripts/site.ts';
      import { canRunWebGL } from '../scripts/gl';

      // the drifting lines: WebGL2 only, never with reduced motion (three.js is loaded on demand)
      const drift = document.querySelector<HTMLCanvasElement>('[data-drift]');
      // The helix is fully transparent until the page is scrolled (see drift.ts `show`), so there is nothing
      // to see before the visitor interacts: start it at the first scroll / wheel / touch / key (the shaders
      // compile off the main thread), so it never competes with first paint.
      if (drift && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let started = false;
        const events = ['scroll', 'wheel', 'touchstart', 'keydown'] as const;
        const go = () => {
          if (started) return;
          started = true;
          events.forEach((e) => removeEventListener(e, go));
          if (!canRunWebGL()) return;
          import('../scripts/flow/drift').then(({ startDrift }) => startDrift(drift));
        };
        events.forEach((e) => addEventListener(e, go, { passive: true }));
      }
    </script>
  </body>
</html>
