---
/**
 * The inquiry chat (data/chat.ts, Honza Nov 19 2026): a launcher on every page and the chat window it opens.
 * Anything with [data-chat-open] opens it too (header CTA, hero, the inquiry section, contact page, CTA
 * panel); [data-chat-service="<slug>"] starts it on that service.
 *
 * The window is markup only until it is first opened; the conversation (scripts/chat/chat.ts) is loaded
 * on demand. The visitor-facing texts are in i18n/chat.json; the questions come from data/inquiry.ts.
 */
import { pick, loc, type Lang } from '../../i18n';
import copy from '../../i18n/chat.json';
import chrome from '../../i18n/chrome.json';
import services from '../../i18n/services.json';
import { ENABLED_SERVICES } from '../../data/capabilities';
import { CHAT_FLOWS, PERSONA } from '../../data/chat';
import { routes } from '../../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(copy, lang);
const c = pick(chrome, lang);
const sv = pick(services, lang);
const list = ENABLED_SERVICES.filter((s) => CHAT_FLOWS[s.slug]).map((s) => {
  const item = sv.capabilities.items.find((i) => i.slug === s.slug)!;
  return { slug: s.slug, title: item.title, covers: item.covers.join(' · ') };
});
const flows = Object.fromEntries(
  list.map((s) => [
    s.slug,
    CHAT_FLOWS[s.slug].map((q) => ({
      id: q.id,
      kind: q.kind,
      optional: !!q.optional,
      title: loc(q.title, lang),
      hint: q.hint ? loc(q.hint, lang) : '',
      options: (q.options ?? []).map((op) => ({ id: op.id, label: loc(op.label, lang) })),
    })),
  ]),
);
const data = { lang, flows, services: list, t, persona: PERSONA.name, mail: c.brand.email };
---

<div class="adv-chat" data-chat data-lang={lang}>
  <button
    type="button"
    class="adv-chat__launcher"
    data-chat-open
    data-chat-launcher
    aria-haspopup="dialog"
    aria-controls="adv-chat-panel"
  >
    <span class="adv-chat__orb" aria-hidden="true"></span>
    <span class="adv-chat__launcher-text">
      <span class="adv-chat__launcher-long">{t.launcher}</span>
      <span class="adv-chat__launcher-short">{t.launcherShort}</span>
    </span>
  </button>

  <div class="adv-chat__scrim" data-chat-scrim hidden></div>

  <section
    id="adv-chat-panel"
    class="adv-chat__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="adv-chat-title"
    data-chat-panel
    hidden
  >
    <div class="adv-chat__hue" aria-hidden="true"></div>
    <header class="adv-chat__head">
      <span class="adv-chat__orb adv-chat__orb--lg" aria-hidden="true"></span>
      <div class="adv-chat__who">
        <p class="adv-chat__name" id="adv-chat-title">
          {PERSONA.name}
          <span class="adv-chat__badge">AI</span>
        </p>
        <p class="adv-chat__role"><i aria-hidden="true"></i>{t.role}</p>
      </div>
      <button type="button" class="adv-chat__icon" data-chat-restart aria-label={t.restart} title={t.restart}>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="1.7"
          ></path></svg
        >
      </button>
      <button type="button" class="adv-chat__icon" data-chat-close aria-label={t.close} title={t.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.7"></path></svg
        >
      </button>
    </header>

    <ol class="adv-chat__log" data-chat-log aria-live="polite" aria-relevant="additions"></ol>
    <div class="adv-chat__dock" data-chat-dock></div>

    <p class="adv-chat__note">
      {t.disclosure}
      <a href={routes.privacy(lang)}>{t.disclosureLink}</a>.
    </p>
  </section>

  <script type="application/json" data-chat-data set:html={JSON.stringify(data)} />
</div>

<script>
  // Load the conversation only when the chat is wanted; warm it up when the pointer heads for a launcher.
  type ChatModule = typeof import('../../scripts/chat/chat');
  let mod: Promise<ChatModule> | null = null;
  const load = () => (mod ??= import('../../scripts/chat/chat'));
  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    document.addEventListener('click', (e) => {
      const el = (e.target as Element | null)?.closest?.<HTMLElement>('[data-chat-open]');
      if (!el || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      load().then((m) => m.openChat(root, el.dataset.chatService ?? '', el));
    });
    document.addEventListener(
      'pointerover',
      (e) => {
        if ((e.target as Element | null)?.closest?.('[data-chat-open]')) load();
      },
      { passive: true },
    );
    // a link with #chat (or ?chat=1) opens it on arrival
    const q = new URLSearchParams(location.search);
    if (location.hash === '#chat' || q.has('chat')) load().then((m) => m.openChat(root, q.get('service') ?? '', null));
  }
</script>

<style is:global>
  @property --adv-hue-a {
    syntax: '<angle>';
    inherits: true;
    initial-value: 0deg;
  }

  /* declared where it is drawn, so each element resolves it with the angle it inherits */
  .adv-chat__orb,
  .adv-chat__launcher::before,
  .adv-chat__hue::before,
  .adv-chat__hue::after {
    --adv-hue: conic-gradient(
      from var(--adv-hue-a),
      rgb(var(--adv-l-ice)),
      rgb(var(--adv-l-cobalt)),
      rgb(var(--adv-l-violet)),
      rgb(var(--adv-l-navy)),
      rgb(var(--adv-l-cobalt)),
      rgb(var(--adv-l-ice))
    );
  }

  /* ---- the orb: the assistant's face, the same light as the window's edge ---- */
  .adv-chat__orb {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.85), transparent 34%),
      radial-gradient(circle at 50% 50%, transparent 52%, rgba(6, 7, 11, 0.55) 100%), var(--adv-hue);
  }
  .adv-chat__orb--lg {
    width: 38px;
    height: 38px;
  }
  .adv-chat__orb--sm {
    width: 26px;
    height: 26px;
  }

  /* ---- launcher ---- */
  .adv-chat__launcher {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 95;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 18px 8px 10px;
    border-radius: 999px;
    border: 0;
    color: var(--adv-text);
    font: 600 0.9375rem/1 var(--adv-display);
    letter-spacing: 0.01em;
    background: var(--adv-glass-bg);
    -webkit-backdrop-filter: var(--adv-glass-blur);
    backdrop-filter: var(--adv-glass-blur);
    isolation: isolate;
    cursor: pointer;
    transition:
      transform 320ms var(--adv-ease),
      opacity 240ms var(--adv-ease);
  }
  .adv-chat__launcher::before {
    /* the hue as a thin ring */
    content: '';
    position: absolute;
    inset: 0;
    padding: 1.25px;
    border-radius: inherit;
    background: var(--adv-hue);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.85;
    z-index: -1;
  }
  .adv-chat__launcher-short {
    display: none;
  }
  .adv-chat__launcher:hover {
    transform: translateY(-2px);
  }
  .adv-chat__launcher:hover .adv-chat__orb {
    animation: adv-hue-turn 1.2s var(--adv-ease) 1;
  }
  .adv-chat__launcher:focus-visible {
    outline: 2px solid var(--adv-accent);
    outline-offset: 3px;
  }
  .adv-chat.is-open .adv-chat__launcher {
    opacity: 0;
    transform: translateY(12px) scale(0.92);
    pointer-events: none;
  }
  .adv-chat.is-booting .adv-chat__launcher {
    animation: adv-chat-rise 640ms var(--adv-ease) both;
  }

  /* ---- scrim and window ---- */
  .adv-chat__scrim {
    position: fixed;
    inset: 0;
    z-index: 170;
    background: rgba(3, 4, 8, 0.42);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  .adv-chat__panel {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 180;
    display: flex;
    flex-direction: column;
    width: min(440px, calc(100vw - 40px));
    height: min(720px, calc(100dvh - 40px));
    border-radius: 26px;
    background:
      radial-gradient(120% 60% at 0% 0%, rgba(var(--adv-l-cobalt), 0.1), transparent 60%),
      radial-gradient(90% 50% at 100% 100%, rgba(var(--adv-l-violet), 0.1), transparent 60%),
      linear-gradient(170deg, rgba(20, 23, 33, 0.9), rgba(8, 9, 14, 0.94));
    -webkit-backdrop-filter: blur(28px) saturate(1.4);
    backdrop-filter: blur(28px) saturate(1.4);
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.9);
    overflow: clip;
    isolation: isolate;
    transform-origin: 100% 100%;
  }
  .adv-chat__panel[hidden],
  .adv-chat__scrim[hidden] {
    display: none;
  }

  /* the hue: a crisp ring plus a soft wash along the inside of the edge (Chrome's AI glow, in the site's
     light). It sweeps once when the window opens and turns while the assistant is thinking. */
  .adv-chat__hue {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
  }
  .adv-chat__hue::before,
  .adv-chat__hue::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--adv-hue);
  }
  .adv-chat__hue::before {
    padding: 1.5px;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.9;
  }
  .adv-chat__hue::after {
    -webkit-mask:
      linear-gradient(90deg, #000, transparent 26px, transparent calc(100% - 26px), #000),
      linear-gradient(180deg, #000, transparent 26px, transparent calc(100% - 26px), #000);
    mask:
      linear-gradient(90deg, #000, transparent 26px, transparent calc(100% - 26px), #000),
      linear-gradient(180deg, #000, transparent 26px, transparent calc(100% - 26px), #000);
    opacity: 0.16;
    transition: opacity 600ms var(--adv-ease);
  }
  .adv-chat.is-open .adv-chat__panel {
    animation: adv-hue-sweep 2.8s var(--adv-ease) 1;
  }
  .adv-chat.is-thinking .adv-chat__panel {
    animation: adv-hue-spin 2.2s linear infinite;
  }
  .adv-chat.is-thinking .adv-chat__hue::after {
    opacity: 0.38;
  }
  @keyframes adv-hue-sweep {
    from {
      --adv-hue-a: -120deg;
    }
    to {
      --adv-hue-a: 240deg;
    }
  }
  @keyframes adv-hue-spin {
    from {
      --adv-hue-a: 0deg;
    }
    to {
      --adv-hue-a: 360deg;
    }
  }
  @keyframes adv-hue-turn {
    from {
      --adv-hue-a: 0deg;
    }
    to {
      --adv-hue-a: 360deg;
    }
  }
  @keyframes adv-chat-rise {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
  }

  /* ---- header ---- */
  .adv-chat__head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 14px 14px 20px;
    border-bottom: 1px solid var(--adv-line);
  }
  .adv-chat__who {
    flex: 1;
    min-width: 0;
  }
  .adv-chat__name {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 1.0625rem/1.2 var(--adv-display);
    color: var(--adv-text);
  }
  .adv-chat__badge {
    padding: 2px 7px;
    border-radius: 6px;
    font: 600 0.6875rem/1.4 var(--adv-sans);
    letter-spacing: 0.06em;
    color: var(--adv-on-accent);
    background: linear-gradient(120deg, rgb(var(--adv-l-ice)), rgb(170, 160, 255));
  }
  .adv-chat__role {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 3px;
    font-size: 0.8125rem;
    color: var(--adv-muted);
  }
  .adv-chat__role i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--adv-accent);
  }
  .adv-chat__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--adv-muted);
    cursor: pointer;
    transition:
      background-color var(--adv-fast) var(--adv-ease),
      color var(--adv-fast) var(--adv-ease);
  }
  .adv-chat__icon svg {
    width: 20px;
    height: 20px;
  }
  .adv-chat__icon:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--adv-text);
  }
  .adv-chat__icon:focus-visible {
    outline: 2px solid var(--adv-accent);
  }

  /* ---- the conversation ---- */
  .adv-chat__log {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 20px 18px 12px;
    list-style: none;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.14) transparent;
    -webkit-mask: linear-gradient(180deg, transparent, #000 18px);
    mask: linear-gradient(180deg, transparent, #000 18px);
  }
  .adv-chat__msg {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    max-width: 100%;
    animation: adv-chat-in 420ms var(--adv-ease) both;
  }
  .adv-chat__msg--ai > .adv-chat__orb {
    margin-bottom: 2px;
  }
  .adv-chat__msg--ai.is-cont > .adv-chat__orb {
    visibility: hidden;
  }
  .adv-chat__msg--me {
    justify-content: flex-end;
    animation-name: adv-chat-in-me;
  }
  .adv-chat__bubble {
    max-width: 82%;
    padding: 11px 15px;
    border-radius: 18px 18px 18px 6px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--adv-text);
    background: rgba(255, 255, 255, 0.055);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    overflow-wrap: anywhere;
  }
  .adv-chat__bubble small {
    display: block;
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--adv-muted);
  }
  .adv-chat__msg--me .adv-chat__bubble {
    border-radius: 18px 18px 6px 18px;
    background:
      linear-gradient(150deg, rgba(var(--adv-l-cobalt), 0.42), rgba(var(--adv-l-violet), 0.34)), rgba(16, 20, 34, 0.6);
    box-shadow: inset 0 0 0 1px rgba(var(--adv-l-ice), 0.18);
  }
  .adv-chat__w {
    animation: adv-chat-word 520ms var(--adv-ease) both;
    animation-delay: calc(var(--i) * 26ms);
  }
  .adv-chat__typing {
    display: inline-flex;
    gap: 5px;
    padding: 15px 16px;
  }
  .adv-chat__typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--adv-l-ice));
    animation: adv-chat-dot 1.1s var(--adv-ease-io) infinite;
  }
  .adv-chat__typing i:nth-child(2) {
    animation-delay: 140ms;
  }
  .adv-chat__typing i:nth-child(3) {
    animation-delay: 280ms;
  }
  .adv-chat__status {
    align-self: center;
    margin: 6px 0;
    font-size: 0.8125rem;
    color: var(--adv-muted);
    animation: adv-chat-in 420ms var(--adv-ease) both;
  }
  .adv-chat__status--ok::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    vertical-align: middle;
    background: var(--adv-accent);
  }
  @keyframes adv-chat-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes adv-chat-in-me {
    from {
      opacity: 0;
      transform: translate(12px, 6px) scale(0.98);
    }
  }
  @keyframes adv-chat-word {
    from {
      opacity: 0;
      filter: blur(4px);
    }
  }
  @keyframes adv-chat-dot {
    0%,
    60%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  /* The cookie panel must never sit under the launcher (it hid "Accept" on phones): while it is open the
     launcher steps aside. */
  html:has(.adv-consent.is-open:not([hidden])) .adv-chat__launcher {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
  }

  /* ---- the dock: what the visitor can do now ---- */
  .adv-chat__dock {
    position: relative;
    z-index: 1;
    padding: 4px 16px 10px;
  }
  .adv-chat__dock [hidden] {
    display: none !important;
  }
  .adv-chat__dock:empty {
    padding: 0;
  }
  .adv-chat__dock > * {
    animation: adv-chat-in 420ms var(--adv-ease) both;
  }
  .adv-chat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-height: 200px;
    overflow-y: auto;
    /* overflow-y: auto also clips x: leave room for the 2px outline + 2px offset of a focused chip. */
    padding: 6px 6px 10px;
    margin: -4px -4px 0;
    scrollbar-width: thin;
  }
  .adv-chat__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    font: 500 0.875rem/1.3 var(--adv-sans);
    color: var(--adv-text);
    text-align: left;
    background: rgba(255, 255, 255, 0.045);
    box-shadow: inset 0 0 0 1px var(--adv-edge);
    cursor: pointer;
    animation: adv-chat-in 380ms var(--adv-ease) both;
    animation-delay: calc(var(--i, 0) * 40ms);
    transition:
      background-color var(--adv-fast) var(--adv-ease),
      box-shadow var(--adv-fast) var(--adv-ease),
      transform var(--adv-fast) var(--adv-ease);
  }
  .adv-chat__chip:hover {
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px var(--adv-edge-hi);
  }
  .adv-chat__chip:active {
    transform: scale(0.97);
  }
  .adv-chat__chip:focus-visible {
    outline: 2px solid var(--adv-accent);
    outline-offset: 2px;
  }
  .adv-chat__chip[aria-pressed='true'] {
    background: rgba(var(--adv-accent-rgb), 0.12);
    box-shadow: inset 0 0 0 1.5px var(--adv-accent);
  }
  .adv-chat__chip[aria-pressed='true']::before {
    content: '';
    width: 12px;
    height: 7px;
    margin: -3px 0 0 -2px;
    border: solid var(--adv-accent);
    border-width: 0 0 2px 2px;
    transform: rotate(-45deg);
  }
  .adv-chat__chips:has(.adv-chat__chip--svc) {
    max-height: none;
  }
  .adv-chat__chip--svc {
    flex: 1 1 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 11px 16px;
    border-radius: 16px;
  }
  .adv-chat__chip--svc small {
    font-size: 0.75rem;
    color: var(--adv-muted);
  }
  .adv-chat__chip--ghost {
    background: transparent;
    color: var(--adv-muted);
  }

  .adv-chat__compose {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 6px 6px 6px 16px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.045);
    box-shadow: inset 0 0 0 1px var(--adv-edge);
    transition: box-shadow var(--adv-fast) var(--adv-ease);
  }
  .adv-chat__compose:focus-within {
    box-shadow: inset 0 0 0 1.5px var(--adv-accent);
  }
  .adv-chat__compose textarea {
    flex: 1;
    min-height: 24px;
    max-height: 132px;
    margin: 8px 0;
    padding: 0;
    border: 0;
    outline: 0;
    resize: none;
    background: transparent;
    color: var(--adv-text);
    font: 400 0.9375rem/1.5 var(--adv-sans);
  }
  .adv-chat__compose textarea::placeholder {
    color: rgba(146, 152, 168, 0.8);
  }
  .adv-chat__send {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    color: var(--adv-ink);
    background: linear-gradient(180deg, var(--adv-paper), var(--adv-paper-2));
    cursor: pointer;
    transition:
      opacity var(--adv-fast) var(--adv-ease),
      transform var(--adv-fast) var(--adv-ease);
  }
  .adv-chat__send svg {
    width: 18px;
    height: 18px;
  }
  .adv-chat__send:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .adv-chat__send:not(:disabled):hover {
    transform: translateY(-1px);
  }
  .adv-chat__send:focus-visible {
    outline: 2px solid var(--adv-accent);
    outline-offset: 2px;
  }
  .adv-chat__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
  }
  .adv-chat__row .adv-btn {
    min-height: 42px;
  }
  .adv-chat__link {
    border: 0;
    padding: 6px 2px;
    background: none;
    color: var(--adv-muted);
    font: 500 0.875rem/1.3 var(--adv-sans);
