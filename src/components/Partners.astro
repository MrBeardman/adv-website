---
/**
 * Partner cards (home and About). Everything readable without hovering: logo on a light plate,
 * category, name, one line, dated facts, link. Facts nobody has confirmed are TODO boxes in development
 * builds only. Words from i18n/about.json (partners), logos and links from data/partners.ts.
 */
import Node from './ui/Node.astro';
import Arrow from './ui/Arrow.astro';
import { pick, fill, type Lang } from '../i18n';
import about from '../i18n/about.json';
import home from '../i18n/home.json';
import { PARTNERS } from '../data/partners';

interface Props {
  lang: Lang;
  /** number shown in the kicker (home: 09); omit for no stream node */
  index?: string;
}
const { lang, index } = Astro.props;
const t = pick(about, lang).partners;
const kicker = pick(home, lang).partners.kicker;
const connected = pick(home, lang).canvas.partners.done;
const byId = Object.fromEntries(t.items.map((c) => [c.id, c]));
const dev = import.meta.env.DEV;
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const id = lang === 'cs' ? 'partneri' : 'partners';
---

<section class="adv-partners adv-section" id={id} aria-labelledby="adv-partners-title">
  <div class="adv-wrap">
    <div class="adv-head">
      <div>
        <h2 id="adv-partners-title" class="adv-h2" data-reveal><Node />{t.title}</h2>
      </div>
      <p class="adv-lead" data-reveal style="--i:1">{t.line}</p>
    </div>
    <ul class="adv-partners__grid">
      {
        PARTNERS.map((p, i) => {
          const c = byId[p.id] ?? { category: '', line: '', facts: [] as string[] };
          const together = (c as { together?: string }).together;
          return (
            <li class="adv-partners__card" data-reveal style={`--i:${i}`}>
              <div class="adv-partners__logo">
                <img
                  src={p.logo}
                  alt={p.name}
                  style={`height:${Math.round(p.logoH * 1.35)}px`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="adv-partners__conn">
                <i />
                {connected}
              </span>
              <h3 class="screen-reader-text">{p.name}</h3>
              <p class="adv-partners__cat">{c.category}</p>
              <p class="adv-partners__line">{c.line}</p>
              {c.facts.length > 0 && (
                <ul class="adv-partners__facts">
                  {c.facts.map((f: string) => (
                    <li>{f}</li>
                  ))}
                </ul>
              )}
              {together ? (
                <p class="adv-partners__together">
                  <span class="adv-label">{t.togetherLabel}</span>
                  {together}
                </p>
              ) : (
                dev && <p class="adv-todo">{fill(t.todoTogether, { name: p.name })}</p>
              )}
              {p.url ? (
                <a class="adv-link adv-partners__link" href={p.url} target="_blank" rel="noopener noreferrer">
                  {fill(t.visit, { host: host(p.url) })}
                  <Arrow dir="up" />
                </a>
              ) : (
                dev && <p class="adv-todo">{fill(t.todoLink, { name: p.name })}</p>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style is:global>
  /* Partners as freestanding logos (Honza, Oct 29 2026): white logos straight on the page, no plates or
     cards; a connected integration in the canvas world. */
  .adv-partners__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .adv-partners__card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 12px;
    padding: 8px clamp(20px, 3vw, 44px) 8px 0;
  }
  .adv-partners__card + .adv-partners__card {
    padding-left: clamp(20px, 3vw, 44px);
    border-left: 1px solid var(--adv-line);
  }
  .adv-partners__logo {
    display: flex;
    align-items: center;
    height: 72px;
    margin-bottom: 6px;
  }
  .adv-partners__logo img {
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }
  .adv-partners__conn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    color: var(--adv-accent);
  }
  .adv-partners__conn i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--adv-accent);
  }
  .adv-partners__cat {
    font-family: var(--adv-display);
    font-weight: 600;
    font-size: 1.125rem;
  }
  .adv-partners__line {
    max-width: 32ch;
    color: var(--adv-muted);
    font-size: 0.9375rem;
  }
  .adv-partners__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .adv-partners__facts li {
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--adv-edge);
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    color: var(--adv-muted);
  }
  .adv-partners__together {
    display: grid;
    gap: 4px;
    font-size: 0.9375rem;
  }
  .adv-partners__link {
    font-size: 0.875rem;
  }
  @media (max-width: 900px) {
    .adv-partners__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .adv-partners__card,
    .adv-partners__card + .adv-partners__card {
      padding: 0;
      border-left: 0;
    }
  }
</style>
