---
import Logo from './ui/Logo.astro';
import Arrow from './ui/Arrow.astro';
import Play from './ui/Play.astro';
import { pick, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import home from '../i18n/home.json';
import { routes } from '../data/routes';
import services from '../i18n/services.json';
import { ENABLED_SERVICES } from '../data/capabilities';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const t = pick(chrome, lang);
const inquiryId = pick(home, lang).workflow.inquiryId;
const other: Lang = lang === 'cs' ? 'en' : 'cs';
const switchHref = alternates[other] ?? routes.home(other);
const path = Astro.url.pathname;
const links = [
  { href: routes.services(lang), label: t.nav.services },
  { href: routes.work(lang), label: t.nav.work },
  { href: `${routes.about(lang)}#${lang === 'cs' ? 'partneri' : 'partners'}`, label: t.nav.partners },
  { href: routes.about(lang), label: t.nav.about },
];
const current = (href: string) => !href.includes('#') && href !== routes.home(lang) && path.startsWith(href);
// "Služby" opens a menu of the services; automation first, under its nav name ("Automatizace a AI").
const sv = pick(services, lang);
const sub = ENABLED_SERVICES.map((s) => ({
  href: routes.service(lang, s.slug),
  label: 'nav' in s ? s.nav[lang] : sv.capabilities.items.find((i) => i.slug === s.slug)!.title,
  body: sv.capabilities.items.find((i) => i.slug === s.slug)!.body,
  rich: 'rich' in s,
}));
---

<header class="adv-header" data-header>
  <div class="adv-header__bar adv-wrap">
    <a class="adv-header__logo" href={routes.home(lang)} aria-label={t.footer.logoLabel}>
      <Logo decorative />
    </a>
    <span class="adv-header__live" aria-hidden="true"><i></i>{t.nav.live}</span>
    <nav class="adv-header__nav" aria-label={t.nav.wordmark}>
      <ul>
        {
          links.map((l, i) =>
            i === 0 ? (
              <li class="adv-header__has-sub" data-sub>
                <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
                <button
                  class="adv-header__caret"
                  type="button"
                  aria-expanded="false"
                  aria-controls="adv-sub"
                  aria-label={l.label}
                >
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path
                      d="M2 3.5 5 6.5 8 3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <div class="adv-sub" id="adv-sub">
                  <ul>
                    {sub.map((s) => (
                      <li>
                        <a
                          href={s.href}
                          class:list={['adv-sub__item', { 'is-rich': s.rich }]}
                          aria-current={current(s.href) ? 'page' : undefined}
                        >
                          <span class="adv-sub__label">
                            <i />
                            {s.label}
                          </span>
                          <span class="adv-sub__body">{s.body}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
    <div class="adv-header__end">
      <a class="adv-header__lang" href={switchHref} hreflang={other} lang={other} aria-label={t.nav.langSwitch}>
        <span aria-hidden="true" class:list={[{ on: lang === 'cs' }]}>CS</span>
        <span aria-hidden="true" class="adv-header__sep">/</span>
        <span aria-hidden="true" class:list={[{ on: lang === 'en' }]}>EN</span>
      </a>
      {/* one split pill: run the inquiry flow (homepage) | plain contact page */}
      <span class="adv-header__cta">
        <a class="adv-btn adv-btn--primary adv-btn--sm" href={`${routes.home(lang)}#${inquiryId}`}>
          <Play />
          {t.nav.run}
        </a>
        <a class="adv-btn adv-btn--sm adv-header__cta-alt" href={routes.contact(lang)}>{t.nav.contact}</a>
      </span>
      <button
        class="adv-header__burger"
        type="button"
        data-burger
        aria-expanded="false"
        aria-controls="adv-drawer"
        aria-label={t.nav.menu}
        data-open={t.nav.menu}
        data-close={t.nav.close}
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="adv-drawer" id="adv-drawer" data-drawer>
    <nav class="adv-wrap" aria-label={t.nav.wordmark}>
      <ul>
        {
          [
            { href: routes.home(lang), label: t.nav.home },
            ...links,
            { href: routes.contact(lang), label: t.nav.contact },
          ].map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href}>
                <span class="adv-drawer__n">{String(i + 1).padStart(2, '0')}</span>
                {l.label}
              </a>
              {l.href === routes.services(lang) && (
                <ul class="adv-drawer__sub">
                  {sub.map((s) => (
                    <li>
                      <a href={s.href}>{s.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="adv-drawer__foot">
        <a href={`mailto:${t.brand.email}`}>{t.brand.email}</a>
        <a href={`tel:${t.brand.phoneHref}`}>{t.brand.phone}</a>
        <a href={switchHref} hreflang={other} lang={other}>{other === 'en' ? 'English' : 'Čeština'}</a>
      </div>
    </nav>
  </div>
</header>

<style is:global>
  /* app chrome (canvas world): a quiet 'workflow active' mark next to the logo */
  .adv-header__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 18px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--adv-edge);
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    color: var(--adv-muted);
  }
  .adv-header__live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--adv-accent);
  }
  @media (max-width: 1180px) {
    .adv-header__live {
      display: none;
    }
  }
  .adv-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: transform 450ms var(--adv-ease);
  }
  .adv-header::before {
    content: '';
    position: absolute;
    inset: 0;
    height: var(--adv-header-h);
    background: rgba(6, 7, 11, 0.7);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border-bottom: 1px solid var(--adv-line);
    opacity: 0;
    transition: opacity 300ms var(--adv-ease);
  }
  .adv-header.is-scrolled::before {
    opacity: 1;
  }
  .adv-header.is-hidden {
    transform: translateY(-100%);
  }
  .adv-header__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--adv-header-h);
  }
  .adv-header__logo {
    display: block;
    width: clamp(150px, 11vw, 172px);
    flex: none;
    border-radius: 6px;
  }
  .adv-header__nav {
    margin-inline: auto;
  }
  .adv-header__nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .adv-header__nav a {
    position: relative;
    display: block;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--adv-muted);
    text-decoration: none;
    transition: color var(--adv-fast) var(--adv-ease);
  }
  .adv-header__nav a::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 3px;
    height: 1px;
    background: var(--adv-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--adv-med) var(--adv-ease);
  }
  .adv-header__nav a:hover,
  .adv-header__nav a[aria-current='page'] {
    color: var(--adv-text);
  }
  .adv-header__nav a:hover::after,
  .adv-header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  /* Services menu */
  .adv-header__has-sub {
    position: relative;
    display: flex;
    align-items: center;
  }
  .adv-header__has-sub > a {
    padding-right: 4px !important;
  }
  .adv-header__has-sub > a::after {
    right: 4px !important;
  }
  .adv-header__caret {
    display: grid;
    place-items: center;
    width: 24px;
    height: 28px;
    margin-right: 6px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--adv-muted);
    cursor: pointer;
    transition:
      color var(--adv-fast) var(--adv-ease),
      transform 300ms var(--adv-ease);
  }
  .adv-header__has-sub:hover .adv-header__caret,
  .adv-header__has-sub.is-open .adv-header__caret {
    color: var(--adv-text);
  }
  .adv-header__has-sub.is-open .adv-header__caret {
    transform: rotate(180deg);
  }
  .adv-sub {
    position: absolute;
    top: calc(100% + 10px);
    left: -18px;
    width: 400px;
    padding: 8px;
    border-radius: 18px;
    background:
      radial-gradient(120% 70% at 20% 0%, rgba(255, 255, 255, 0.07), transparent 55%),
      linear-gradient(165deg, rgba(24, 27, 36, 0.97), rgba(11, 12, 17, 0.97));
    box-shadow: var(--adv-shadow-card);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition:
      opacity 250ms var(--adv-ease),
      translate 250ms var(--adv-ease),
      visibility 0s linear 250ms;
  }
  .adv-sub::before {
    /* hover bridge between the link and the panel */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    height: 12px;
  }
  .adv-header__has-sub.is-open .adv-sub,
  .no-js .adv-header__has-sub:hover .adv-sub,
  .no-js .adv-header__has-sub:focus-within .adv-sub {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition:
      opacity 250ms var(--adv-ease),
      translate 250ms var(--adv-ease);
  }
  .adv-sub ul {
    display: grid !important;
    gap: 2px !important;
  }
  .adv-header__nav .adv-sub__item {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 12px;
    transition: background-color var(--adv-fast) var(--adv-ease);
  }
  .adv-header__nav .adv-sub__item::after {
    display: none;
  }
  .adv-header__nav .adv-sub__item:hover,
  .adv-header__nav .adv-sub__item[aria-current='page'] {
    background: rgba(255, 255, 255, 0.04);
  }
  .adv-sub__label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--adv-text);
  }
  .adv-sub__label i {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .adv-sub__item.is-rich .adv-sub__label i {
    border-color: var(--adv-accent);
    background: rgba(124, 200, 255, 0.2);
  }
  .adv-sub__body {
    padding-left: 19px;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--adv-muted);
  }
  .adv-drawer__sub {
    display: grid;
    gap: 2px;
    margin: -6px 0 14px 34px !important;
  }
  .adv-drawer__sub li {
    border: 0 !important;
  }
  .adv-drawer__sub a {
    display: block !important;
    padding: 6px 0 !important;
    font-family: var(--adv-sans) !important;
    font-size: 1rem !important;
    font-weight: 500 !important;
    color: var(--adv-muted);
  }
  .adv-header__end {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .adv-header__cta {
    display: inline-flex;
    align-items: stretch;
    padding: 3px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--adv-edge);
    background: rgba(255, 255, 255, 0.03);
  }
  .adv-header__cta-alt {
    color: var(--adv-muted);
    background: none;
    box-shadow: none;
    transition: color var(--adv-fast) var(--adv-ease);
  }
  .adv-header__cta-alt:hover,
  .adv-header__cta-alt:focus-visible {
    color: var(--adv-text);
  }
  .adv-header__lang {
    display: inline-flex;
    gap: 6px;
    padding: 8px 6px;
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--adv-muted);
    text-decoration: none;
  }
  .adv-header__lang .on {
    color: var(--adv-text);
  }
  .adv-header__lang:hover span {
    color: var(--adv-text);
  }
  .adv-header__sep {
    opacity: 0.4;
  }
  .adv-header__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid var(--adv-edge);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
  }
  .adv-header__burger span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: var(--adv-text);
    transition:
      transform 350ms var(--adv-ease),
      top 350ms var(--adv-ease);
  }
  .adv-header__burger span:first-child {
    top: 17px;
  }
  .adv-header__burger span:last-child {
    top: 25px;
  }
  .adv-header.is-open .adv-header__burger span:first-child {
    top: 21px;
    transform: rotate(45deg);
  }
  .adv-header.is-open .adv-header__burger span:last-child {
    top: 21px;
    transform: rotate(-45deg);
  }

  .adv-drawer {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: calc(var(--adv-header-h) + 24px);
    background: rgba(9, 10, 14, 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 350ms var(--adv-ease),
      visibility 0s linear 350ms;
    overflow-y: auto;
  }
  .adv-header.is-open .adv-drawer {
    opacity: 1;
    visibility: visible;
    transition: opacity 350ms var(--adv-ease);
  }
  .adv-drawer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .adv-drawer li {
    border-bottom: 1px solid var(--adv-line);
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 500ms var(--adv-ease),
      translate 500ms var(--adv-ease);
    transition-delay: calc(var(--i) * 50ms + 80ms);
  }
  .adv-header.is-open .adv-drawer li {
    opacity: 1;
    translate: 0 0;
  }
  .adv-drawer li a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    font-family: var(--adv-display);
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .adv-drawer__n {
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--adv-accent);
  }
  .adv-drawer__foot {
    display: grid;
    gap: 10px;
    padding: 28px 0 40px;
    color: var(--adv-muted);
  }
  .adv-drawer__foot a {
    text-decoration: none;
  }

  @media (max-width: 1000px) {
    .adv-header__nav,
    .adv-header__cta {
      display: none;
    }
    .adv-header__burger {
      display: block;
    }
    .adv-header__end {
      margin-left: auto;
    }
  }
  @media (min-width: 1001px) {
    .adv-drawer {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .adv-header__logo {
      width: 140px;
    }
  }
</style>
