---
/**
 * One project on the work index (templates/Work.astro), Nov 1 2026: a glass card with the product in
 * code-drawn devices (ui/Devices.astro) when the case has flat screenshots, else its image, else an ADV
 * cover; then its state, sector and year, the client, the outcome in one or two lines, the services and
 * the link. The whole card is the link when the case has a page; without one there is no hover and no
 * arrow, so nothing promises a page that does not exist. `featured`: media and copy side by side.
 */
import Arrow from './ui/Arrow.astro';
import Devices from './ui/Devices.astro';
import { pick, loc, type Lang } from '../i18n';
import services from '../i18n/services.json';
import work from '../i18n/work.json';
import { routes } from '../data/routes';
import { ENABLED_SERVICES } from '../data/capabilities';
import type { CaseStudy } from '../data/caseStudies';

interface Props {
  lang: Lang;
  c: CaseStudy;
  featured?: boolean;
  /** stagger index for the reveal */
  i?: number;
}
const { lang, c, featured = false, i = 0 } = Astro.props;
const s = pick(services, lang);
const w = pick(work, lang).case;
const client = loc(c.client, lang);
const svc = c.services
  .filter((sl) => ENABLED_SERVICES.some((x) => x.slug === sl))
  .map((sl) => s.capabilities.items.find((it) => it.slug === sl)?.title)
  .filter(Boolean);
const meta = [loc(c.sector, lang), c.year].filter(Boolean).join(' · ');
const state = c.detail?.state ? w.state[c.detail.state] : '';
const linked = !!c.detail;
const Tag = linked ? 'a' : 'div';
const initials = client
  .split(/\s+/)
  .slice(0, 2)
  .map((x) => x[0])
  .join('')
  .toUpperCase();
---

<li class:list={['adv-cc', { 'adv-cc--featured': featured }]} data-services={c.services.join(' ')} data-reveal style={`--i:${i}`}>
  <Tag
    class:list={['adv-cc__card adv-card', { 'adv-card--lift': linked, 'is-static': !linked }]}
    href={linked ? routes.case(lang, c.slug) : undefined}
  >
    <span class="adv-cc__media">
      {
        c.screens ? (
          <Devices desktop={c.screens.desktop} mobile={c.screens.mobile} float={c.screens.float} alt={client} />
        ) : c.image ? (
          <img class="adv-cc__img" src={c.image} alt="" loading="lazy" decoding="async" width="1200" height="750" />
        ) : (
          <span class="adv-cc__cover" aria-hidden="true">
            {initials}
          </span>
        )
      }
    </span>
    <span class="adv-cc__body">
      <span class="adv-cc__meta">
        {
          state && (
            <span class:list={['adv-cc__state', `is-${c.detail?.state}`]}>
              <i />
              {state}
            </span>
          )
        }
        {meta && <span>{meta}</span>}
        {c.status !== 'published' && <span class="adv-cc__badge">{c.status}</span>}
      </span>
      <span class="adv-cc__client">{client}</span>
      <span class="adv-cc__outcome">{loc(c.outcome, lang)}</span>
      {
        svc.length > 0 && (
          <span class="adv-cc__tags">
            {svc.map((t) => (
              <span>{t}</span>
            ))}
          </span>
        )
      }
      {
        linked && (
          <span class="adv-cc__go">
            {s.service.readCase}
            <Arrow />
          </span>
        )
      }
    </span>
  </Tag>
</li>

<style is:global>
  .adv-cc {
    display: grid;
  }
  .adv-cc__card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }
  .adv-cc__card.is-static {
    cursor: default;
  }
  .adv-cc__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: clamp(18px, 3vw, 40px) clamp(18px, 3vw, 44px) 0;
    overflow: hidden;
    background:
      radial-gradient(70% 80% at 50% 100%, rgba(var(--adv-l-cobalt), 0.22), transparent 70%),
      radial-gradient(60% 70% at 85% 10%, rgba(var(--adv-l-violet), 0.16), transparent 70%);
    border-bottom: 1px solid var(--adv-line);
  }
  .adv-cc__media .adv-dev {
    width: 100%;
    margin: 0;
    transition: translate 600ms var(--adv-ease);
  }
  .adv-cc__card:hover .adv-dev {
    translate: 0 -6px;
  }
  .adv-cc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px 12px 0 0;
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.9);
    transition: scale 700ms var(--adv-ease);
  }
  .adv-cc__card:hover .adv-cc__img {
    scale: 1.03;
  }
  .adv-cc__cover {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 12px 12px 0 0;
    font-family: var(--adv-display);
    font-size: 3rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    background: linear-gradient(135deg, rgba(var(--adv-l-navy), 0.8), rgba(var(--adv-l-violet), 0.5));
  }
  .adv-cc__body {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(22px, 2.6vw, 34px);
  }
  .adv-cc__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-size: 0.8125rem;
    color: var(--adv-muted);
  }
  .adv-cc__state {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    color: var(--adv-accent);
    box-shadow: inset 0 0 0 1px rgba(var(--adv-accent-rgb), 0.35);
  }
  .adv-cc__state i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .adv-cc__state.is-in-progress {
    color: #f5a524;
    box-shadow: inset 0 0 0 1px rgba(245, 165, 36, 0.35);
  }
  .adv-cc__state.is-in-progress i {
    animation: adv-cc-pulse 1.8s ease-in-out infinite;
  }
  @keyframes adv-cc-pulse {
    50% {
      opacity: 0.35;
    }
  }
  .adv-cc__badge {
    font-family: var(--adv-mono);
    font-size: 0.6875rem;
    color: #ffd9a8;
  }
  .adv-cc__client {
    font-family: var(--adv-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--adv-text);
  }
  .adv-cc__outcome {
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--adv-muted);
  }
  .adv-cc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .adv-cc__tags span {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--adv-text);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .adv-cc__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-weight: 600;
    color: var(--adv-text);
  }
  .adv-cc__go .adv-arr {
    transition: translate 300ms var(--adv-ease);
  }
  .adv-cc__card:hover .adv-cc__go .adv-arr {
    translate: 4px 0;
  }

  /* the featured project: media and copy side by side */
  @media (min-width: 900px) {
    .adv-cc--featured {
      grid-column: 1 / -1;
    }
    .adv-cc--featured .adv-cc__card {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      grid-template-rows: none;
    }
    .adv-cc--featured .adv-cc__media {
      aspect-ratio: auto;
      min-height: 420px;
      padding: clamp(24px, 3vw, 48px);
      border-bottom: 0;
      border-right: 1px solid var(--adv-line);
    }
    .adv-cc--featured .adv-cc__body {
      align-content: center;
      padding: clamp(28px, 3.4vw, 52px);
    }
    .adv-cc--featured .adv-cc__client {
      font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem);
    }
  }
</style>
