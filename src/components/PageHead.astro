---
/**
 * Head of every inner page: kicker, H1 (optionally one word in the emphasis face), lead, and a slot for
 * extras (back link, chips). A still hairline grid with a navy glow behind it echoes the hero's grid
 * without animating it.
 */
interface Props {
  kicker: string;
  title: string;
  /** one word of the title to set in the emphasis face (.adv-em); must occur in the title */
  em?: string;
  lead?: string;
}
const { kicker, title, em, lead } = Astro.props;
const i = em ? title.lastIndexOf(em) : -1;
const parts = i >= 0 ? [title.slice(0, i), em!, title.slice(i + em!.length)] : [title, '', ''];
---

<header class="adv-pagehead">
  <div class="adv-pagehead__grid" aria-hidden="true"></div>
  <div class="adv-wrap adv-pagehead__inner">
    <slot name="before" />
    <p class="adv-kicker"><i></i>{kicker}</p>
    <h1 class="adv-pagehead__title" data-lines>
      <span class="adv-line"><span>{parts[0]}{parts[1] && <em class="adv-em">{parts[1]}</em>}{parts[2]}</span></span>
    </h1>
    {
      lead && (
        <p class="adv-lead adv-pagehead__lead" data-reveal style="--i:2">
          {lead}
        </p>
      )
    }
    <slot />
  </div>
</header>

<style is:global>
  .adv-pagehead {
    position: relative;
    padding: calc(var(--adv-header-h) + clamp(56px, 8vw, 120px)) 0 clamp(48px, 6vw, 80px);
    overflow: clip;
  }
  .adv-pagehead__grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(236, 238, 244, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgba(236, 238, 244, 0.05) 1px, transparent 1px) 0 0 / 56px 56px;
    -webkit-mask-image: radial-gradient(80% 90% at 75% 20%, #000 20%, transparent 75%);
    mask-image: radial-gradient(80% 90% at 75% 20%, #000 20%, transparent 75%);
  }
  .adv-pagehead::after {
    content: '';
    position: absolute;
    right: -10%;
    top: -20%;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    background: radial-gradient(closest-side, var(--adv-glow), transparent 70%);
    pointer-events: none;
  }
  .adv-pagehead__inner {
    position: relative;
    z-index: 1;
  }
  .adv-pagehead__title {
    max-width: 18ch;
    font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.75rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .adv-pagehead__lead {
    max-width: 56ch;
    margin-top: 26px;
  }
</style>
