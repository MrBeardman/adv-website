---
/**
 * Numbers band: the four headline numbers (data/homeNumbers.ts, the one place they live), each counting
 * up with a thin drawn chart. Websites: bookings against a 1× and a 2× reference line, flat until the
 * relaunch, then up to exactly 2× (the scale is true: 2× is twice as high as 1×). Software: the seven
 * days from the call to the prototype, filling one by one (Honza, Nov 12 2026: the plain line and the
 * row of dots looked lazy). Placeholders (invented, see the launch checklist in docs/STATUS.md) get a
 * dashed outline in development builds.
 */
import Node from '../ui/Node.astro';
import Arrow from '../ui/Arrow.astro';
import { pick, loc, type Lang } from '../../i18n';
import home from '../../i18n/home.json';
import { HOME_NUMBERS } from '../../data/homeNumbers';
import { ENABLED_SERVICES } from '../../data/capabilities';
import { routes } from '../../data/routes';
import { findCaseStudy } from '../../data/caseStudies';

interface Props {
  lang: Lang;
  /** kicker number = node on the stream; omit for a plain kicker */
  index?: string;
}
const { lang, index } = Astro.props;
const t = pick(home, lang).numbers;
const dev = import.meta.env.DEV;
const items = HOME_NUMBERS.filter((n) => ENABLED_SERVICES.some((s) => s.slug === n.slug)).map((n) => ({
  ...n,
  href:
    n.link.kind === 'case' && findCaseStudy(n.link.slug)
      ? routes.case(lang, n.link.slug)
      : routes.service(lang, n.link.kind === 'service' ? n.link.slug : n.slug),
}));
const [before, after] = t.title.split(t.em);
const bars = [0.08, 0.16, 0.25, 0.33, 0.41, 0.5, 0.58, 0.66, 0.75, 0.83, 0.91, 1];
// chart captions (decorative: the charts are aria-hidden, the label above says the same)
const cap =
  lang === 'cs'
    ? { relaunch: 'relaunch', after: '+2 měsíce', call: 'hovor', proto: 'prototyp', before: 'před', now: 'teď' }
    : { relaunch: 'relaunch', after: '+2 months', call: 'call', proto: 'prototype', before: 'before', now: 'now' };
// bookings: y 36 = 1×, y 12 = 2× (0 at y 60); the relaunch is at x 70
const RISE = 'M0 37 C8 36 14 35 22 36 S38 38 48 36 S62 35 70 36 C90 35 104 31 120 26 S160 15 200 12';
---

<section class="adv-numbers adv-section" aria-labelledby="adv-numbers-title">
  <div class="adv-wrap">
    <h2 id="adv-numbers-title" class="adv-h2 adv-numbers__title" data-reveal>
      <Node />{before}<em class="adv-em">{t.em}</em>{after}
    </h2>
    <ul class="adv-numbers__grid">
      {
        items.map((n, i) => (
          <li class="adv-numbers__item" data-play data-reveal style={`--i:${i}`}>
            <p class="adv-numbers__value">
              <span
                class:list={[{ 'adv-ph': dev && n.placeholder }]}
                data-count={n.count}
                data-prefix={n.prefix ?? ''}
                data-suffix={loc(n.suffix, lang)}
                data-delay={i * 120}
                aria-hidden="true"
              >
                {loc(n.value, lang)}
              </span>
              <span class="screen-reader-text">{loc(n.value, lang)}</span>
            </p>
            <p class="adv-numbers__label">{loc(n.label, lang)}</p>
            <div class={`adv-mini adv-mini--${n.slug}`} aria-hidden="true">
              {n.slug === 'ai-automation' && (
                <span class="adv-mini__cols">
                  {bars.map((h, k) => (
                    <i style={`--h:${h};--k:${k}`} />
                  ))}
                </span>
              )}
              {n.slug === 'business-optimisation' && (
                <span class="adv-fee">
                  <b>{cap.before}</b>
                  <i style="--w:1" />
                  <b>{cap.now}</b>
                  <i style="--w:0.209" />
                </span>
              )}
              {n.slug === 'websites' && (
                <span class="adv-rise">
                  <span class="adv-rise__y">
                    <b style="--y:0.2">2×</b>
                    <b style="--y:0.6">1×</b>
                  </span>
                  <span class="adv-rise__plot">
                    <svg viewBox="0 0 200 60" preserveAspectRatio="none">
                      <defs>
                        <linearGradient id="adv-rise-fill" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0" stop-color="rgb(124 200 255)" stop-opacity="0.3" />
                          <stop offset="1" stop-color="rgb(124 200 255)" stop-opacity="0" />
                        </linearGradient>
                      </defs>
                      <line class="adv-rise__ref" x1="0" y1="12" x2="200" y2="12" />
                      <line class="adv-rise__ref" x1="0" y1="36" x2="200" y2="36" />
                      <line class="adv-rise__mark" x1="70" y1="0" x2="70" y2="60" />
                    </svg>
                    <svg class="adv-rise__data" viewBox="0 0 200 60" preserveAspectRatio="none">
                      <path class="adv-rise__area" d={`${RISE} L200 60 L0 60 Z`} />
                      <path class="adv-mini__line" d={RISE} />
                    </svg>
                    <i class="adv-rise__dot" />
                  </span>
                  <span class="adv-rise__x">
                    <b style="--x:0.35">{cap.relaunch}</b>
                    <b class="is-end">{cap.after}</b>
                  </span>
                </span>
              )}
              {n.slug === 'software' && (
                <span class="adv-week">
                  <span class="adv-week__ends">
                    <b>{cap.call}</b>
                    <b>{cap.proto}</b>
                  </span>
                  <span class="adv-week__days">
                    {Array.from({ length: 7 }, (_, k) => (
                      <i style={`--k:${k}`}>
                        <b>{k + 1}</b>
                      </i>
                    ))}
                  </span>
                </span>
              )}
            </div>
            <a class="adv-link adv-numbers__link" href={n.href}>
              {loc(n.linkLabel, lang)}
              <Arrow />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  .adv-numbers__title {
    margin-bottom: clamp(36px, 4.5vw, 60px);
  }
  .adv-numbers__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--adv-edge);
  }
  .adv-numbers__item {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 12px;
    padding: 30px 24px 8px;
  }
  .adv-numbers__item + .adv-numbers__item {
    border-left: 1px solid var(--adv-line);
  }
  .adv-numbers__item:first-child {
    padding-left: 0;
  }
  .adv-numbers__value {
    font-family: var(--adv-display);
    font-size: clamp(2.25rem, 1.3rem + 1.6vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .adv-numbers__label {
    color: var(--adv-muted);
    font-size: 0.9375rem;
    max-width: 26ch;
  }
  .adv-numbers__link {
    justify-self: start;
    font-size: 0.875rem;
    margin-top: 6px;
  }
  .adv-mini {
    height: 44px;
    display: flex;
    align-items: flex-end;
  }
  /* e-shop fees before and now (these styles used to come from 05-kesia.astro, which no page loads any more) */
  .adv-fee {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 9px 10px;
    width: 100%;
    margin: 0 0 4px;
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--adv-muted);
  }
  .adv-fee b {
    font-weight: 500;
  }
  .adv-fee b:nth-of-type(2) {
    color: var(--adv-accent);
  }
  .adv-fee i {
    display: block;
    height: 6px;
    width: calc(var(--w) * 100%);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.22);
    transform-origin: left;
  }
  .adv-fee i:last-child {
    background: var(--adv-accent);
  }
  .adv-mini__cols {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    width: 100%;
    height: 100%;
  }
  .adv-mini__cols i {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 2px 2px 0 0;
    background: linear-gradient(180deg, var(--adv-accent), rgba(124, 200, 255, 0.25));
    transform-origin: bottom;
  }
  .adv-mini svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .adv-mini__line {
    fill: none;
    stroke: var(--adv-accent);
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }
  /* the two charts with captions are taller than the plain ones; the label row above takes up the slack */
  .adv-mini--websites,
  .adv-mini--software {
    height: auto;
  }
  /* websites: bookings against the 1× and 2× lines */
  .adv-rise {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 8px;
    width: 100%;
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--adv-muted);
  }
  .adv-rise b {
    font-weight: 500;
  }
  .adv-rise__y {
    position: relative;
    width: 2ch;
    height: 60px;
  }
  .adv-rise__y b {
    position: absolute;
    right: 0;
    top: calc(var(--y) * 100%);
    transform: translateY(-50%);
  }
  .adv-rise__y b:first-child {
    color: var(--adv-accent);
  }
  .adv-rise__plot {
    position: relative;
    height: 60px;
    border-left: 1px solid var(--adv-edge);
    border-bottom: 1px solid var(--adv-edge);
  }
  .adv-rise__plot svg {
    position: absolute;
    inset: 0;
    display: block;
  }
  .adv-rise__ref,
  .adv-rise__mark {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }
  .adv-rise__area {
    fill: url(#adv-rise-fill);
    stroke: none;
  }
  .adv-rise__dot {
    position: absolute;
    right: -4px;
    top: calc(20% - 4px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--adv-accent);
    border: 2px solid var(--adv-bg-2, #0c0e14);
    box-sizing: content-box;
    margin: -2px;
  }
  .adv-rise__x {
    grid-column: 2;
    position: relative;
    height: 12px;
    margin-top: 8px;
  }
  .adv-rise__x b {
    position: absolute;
    left: calc(var(--x) * 100%);
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .adv-rise__x b.is-end {
    left: auto;
    right: 0;
    transform: none;
  }
  /* software: seven days, call to prototype */
  .adv-week {
    display: grid;
    gap: 8px;
    width: 100%;
    font-family: var(--adv-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--adv-muted);
  }
  .adv-week b {
    font-weight: 500;
  }
  .adv-week__ends {
    display: flex;
    justify-content: space-between;
  }
  .adv-week__ends b:last-child {
    color: var(--adv-accent);
  }
  .adv-week__days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }
  .adv-week__days i {
    display: grid;
    gap: 7px;
    justify-items: center;
    font-style: normal;
  }
  .adv-week__days i::before {
    content: '';
    width: 100%;
    height: 8px;
    border-radius: 2px;
    background: rgba(124, 200, 255, calc(0.28 + var(--k) * 0.09));
    transform-origin: left;
  }
  .adv-week__days i:last-child::before {
    background: var(--adv-accent);
  }
  .adv-week__days i:last-child b {
    color: var(--adv-accent);
  }
  .js [data-play].is-armed .adv-mini__cols i {
    transform: scaleY(0);
    transition: transform 900ms var(--adv-ease);
    transition-delay: calc(var(--k) * 60ms);
  }
  /* drawn by opening a clip from the left: a dash offset goes wrong with non-scaling strokes */
  .js [data-play].is-armed .adv-rise__data {
    clip-path: inset(-8px 100% -8px 0);
    transition: clip-path 1600ms var(--adv-ease-io);
  }
  .js [data-play].is-armed .adv-fee i {
    transform: scaleX(0);
    transition: transform 1400ms var(--adv-ease);
  }
  .js [data-play].is-armed .adv-fee i:last-child {
    transition-delay: 250ms;
  }
  .js [data-play].is-armed .adv-rise__area {
    opacity: 0;
    transition: opacity 900ms var(--adv-ease) 700ms;
  }
  .js [data-play].is-armed .adv-rise__dot {
    transform: scale(0);
    transition: transform 400ms var(--adv-ease) 1500ms;
  }
  .js [data-play].is-armed .adv-week__days i::before {
    transform: scaleX(0);
    transition: transform 420ms var(--adv-ease);
    transition-delay: calc(var(--k) * 130ms);
  }
  .js [data-play].is-armed .adv-week__days i b {
    opacity: 0.35;
    transition: opacity 300ms var(--adv-ease);
    transition-delay: calc(var(--k) * 130ms + 200ms);
  }
  .js [data-play].is-playing .adv-mini__cols i {
    transform: scaleY(1);
  }
  .js [data-play].is-playing .adv-rise__data {
    clip-path: inset(-8px 0 -8px 0);
  }
  .js [data-play].is-playing .adv-fee i {
    transform: none;
  }
  .js [data-play].is-playing .adv-rise__area {
    opacity: 1;
  }
  .js [data-play].is-playing .adv-rise__dot {
    transform: none;
  }
  .js [data-play].is-playing .adv-week__days i::before {
    transform: none;
  }
  .js [data-play].is-playing .adv-week__days i b {
    opacity: 1;
  }
  @media (max-width: 1000px) {
    .adv-numbers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .adv-numbers__item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .adv-numbers__item:nth-child(n + 3) {
      border-top: 1px solid var(--adv-line);
    }
  }
  @media (max-width: 560px) {
    .adv-numbers__grid {
      grid-template-columns: 1fr;
    }
    .adv-numbers__item,
    .adv-numbers__item + .adv-numbers__item {
      padding-left: 0;
      border-left: 0;
    }
    .adv-numbers__item + .adv-numbers__item {
      border-top: 1px solid var(--adv-line);
    }
  }
</style>
