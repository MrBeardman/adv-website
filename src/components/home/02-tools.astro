---
/**
 * Tools strip: the systems we connect, as one calm row of names (no marquee: everything readable at once).
 * When it scrolls in, the names light one after another, like a workflow connecting them, once.
 * TODO (Honza): the list is a placeholder until confirmed (docs/STATUS.md). Names only, no logos:
 * third-party logos need permission and would pull the eye away from ours.
 */
import Node from '../ui/Node.astro';
import { pick, type Lang } from '../../i18n';
import home from '../../i18n/home.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(home, lang).tools;
// TODO (Honza): confirm the tool list.
const TOOLS = [
  'Shoptet',
  'Shopify',
  'Google Workspace',
  'Microsoft 365',
  'Pohoda',
  'Fakturoid',
  'n8n',
  'Make',
  'OpenAI',
  'Claude',
];
const dev = import.meta.env.DEV;
---

<section class="adv-tools" aria-labelledby="adv-tools-title">
  <div class="adv-wrap">
    <h2 id="adv-tools-title" class="adv-tools__title" data-reveal><Node />{t.title}</h2>
    {
      dev && (
        <p class="adv-todo adv-tools__todo">TODO: seznam nástrojů je zástupný, potvrdit (jen ve vývojovém buildu).</p>
      )
    }
    <ul class="adv-tools__list" data-play>
      {TOOLS.map((n, i) => <li style={`--k:${i}`}>{n}</li>)}
    </ul>
  </div>
</section>

<style is:global>
  .adv-tools {
    position: relative;
    padding: clamp(40px, 6vw, 80px) 0 clamp(60px, 7vw, 100px);
  }
  .adv-tools__title {
    max-width: 24ch;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--adv-muted);
  }
  .adv-tools__todo {
    margin-top: 14px;
    justify-self: start;
  }
  .adv-tools__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--adv-line);
  }
  .adv-tools__list li {
    display: flex;
    align-items: center;
    padding: 18px 22px 18px 0;
    font-family: var(--adv-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgba(241, 242, 245, 0.72);
    white-space: nowrap;
    transition: color 500ms var(--adv-ease);
    transition-delay: calc(var(--k) * 90ms);
  }
  .adv-tools__list li + li::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-right: 22px;
    border-radius: 2px;
    border: 1px solid rgba(var(--adv-accent-rgb), 0.55);
  }
  .js .adv-tools__list.is-armed li {
    color: rgba(241, 242, 245, 0.28);
  }
  .js .adv-tools__list.is-playing li {
    color: rgba(241, 242, 245, 0.72);
  }
</style>
