---
/**
 * Tools strip: the systems we connect, as one seamless endless row (Honza, Nov 5 2026: "so it seems like we do a lot
 * of things"; his call over the no-marquee rule). CSS only: the same list twice, moved by exactly one copy per loop
 * (one copy is wider than the capped .adv-wrap, so two always fill it). It stops under the pointer and off screen. Screen readers get one
 * list; with reduced motion it is that one list, still and wrapped.
 * TODO (Honza): the list is a placeholder until confirmed (docs/STATUS.md). Names only, no logos:
 * third-party logos need permission and would pull the eye away from ours.
 */
import Node from '../ui/Node.astro';
import { pick, type Lang } from '../../i18n';
import home from '../../i18n/home.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(home, lang).tools;
// TODO (Honza): confirm the tool list.
const TOOLS = [
  'Shoptet',
  'Shopify',
  'Google Workspace',
  'Microsoft 365',
  'Pohoda',
  'Fakturoid',
  'n8n',
  'Make',
  'OpenAI',
  'Claude',
];
const dev = import.meta.env.DEV;
---

<section class="adv-tools" aria-labelledby="adv-tools-title">
  <div class="adv-wrap">
    <h2 id="adv-tools-title" class="adv-tools__title" data-reveal><Node />{t.title}</h2>
    {
      dev && (
        <p class="adv-todo adv-tools__todo">TODO: seznam nástrojů je zástupný, potvrdit (jen ve vývojovém buildu).</p>
      )
    }
    <div class="adv-tools__strip" data-live>
      <div class="adv-tools__track">
        {
          [0, 1].map((copy) => (
            <ul class="adv-tools__list" aria-hidden={copy > 0 ? 'true' : undefined}>
              {TOOLS.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  .adv-tools {
    position: relative;
    padding: clamp(40px, 6vw, 80px) 0 clamp(60px, 7vw, 100px);
  }
  .adv-tools__title {
    max-width: 24ch;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--adv-muted);
  }
  .adv-tools__todo {
    margin-top: 14px;
    justify-self: start;
  }
  .adv-tools__strip {
    margin-top: 36px;
    border-block: 1px solid var(--adv-line);
    overflow: clip;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .adv-tools__track {
    display: flex;
    width: max-content;
    animation: adv-tools-slide 40s linear infinite;
  }
  .adv-tools__strip:hover .adv-tools__track {
    animation-play-state: paused;
  }
  @keyframes adv-tools-slide {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .adv-tools__list {
    flex: none;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .adv-tools__list li {
    display: flex;
    align-items: center;
    padding: 18px 22px 18px 0;
    font-family: var(--adv-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgba(241, 242, 245, 0.72);
    white-space: nowrap;
    transition: color 200ms var(--adv-ease);
  }
  .adv-tools__list li:hover {
    color: var(--adv-text);
  }
  /* every name has its mark in front, also the first of a copy, so the seam does not show */
  .adv-tools__list li::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-right: 22px;
    border-radius: 2px;
    border: 1px solid rgba(var(--adv-accent-rgb), 0.55);
  }
  @media (prefers-reduced-motion: reduce) {
    .adv-tools__strip {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .adv-tools__track {
      width: auto;
      animation: none;
    }
    .adv-tools__list {
      flex: 1;
      flex-wrap: wrap;
    }
    .adv-tools__list[aria-hidden] {
      display: none;
    }
    .adv-tools__list li:first-child::before {
      display: none;
    }
  }
</style>
