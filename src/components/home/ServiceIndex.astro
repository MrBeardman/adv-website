---
/**
 * Homepage services (Honza, Oct 29 2026): the four services as a 2×2 grid of cards, each a link to its
 * service page. Every card opens with a small live UI preview of the work (ui/Scene.astro, in an app
 * window) like a product screenshot, then what it covers and its one checkable result (homeNumbers.ts).
 * The page light shows through on hover (.adv-lit).
 */
import Arrow from '../ui/Arrow.astro';
import Node from '../ui/Node.astro';
import Scene from '../ui/Scene.astro';
import { pick, loc, type Lang } from '../../i18n';
import services from '../../i18n/services.json';
import { ENABLED_SERVICES } from '../../data/capabilities';
import { numberFor } from '../../data/homeNumbers';
import { routes } from '../../data/routes';
import { SHAPES } from '../../scripts/stack/iconShapes.js';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = pick(services, lang);
const DEV = import.meta.env.DEV;
const ICON: Record<string, string> = {
  'ai-automation': 'nodes',
  'business-optimisation': 'racks',
  websites: 'globe',
  software: 'diamondCore',
};
type Shape = { d?: string; circle?: number[]; rect?: number[] };
const shapes = (name: string) => (SHAPES as Record<string, Shape[]>)[name] ?? [];
const items = ENABLED_SERVICES.map((sv) => {
  const copy = s.capabilities.items.find((i) => i.slug === sv.slug)!;
  return {
    slug: sv.slug,
    href: routes.service(lang, sv.slug),
    title: copy.title,
    body: copy.body,
    covers: copy.covers,
    icon: ICON[sv.slug] ?? 'nodes',
    number: numberFor(sv.slug),
  };
});
---

<section class="adv-section adv-sidx" aria-labelledby="adv-sidx-title">
  <div class="adv-wrap">
    <h2 id="adv-sidx-title" class="adv-h2 adv-sidx__title" data-reveal><Node />{s.capabilities.title}</h2>
    <ul class="adv-sidx__list">
      {
        items.map((it, k) => (
          <li data-reveal style={`--i:${k}`}>
            <a class="adv-sidx__row adv-lit" href={it.href}>
              <span class="adv-sidx__preview" aria-hidden="true">
                <span class="adv-sidx__dots">
                  <i />
                  <i />
                  <i />
                </span>
                <Scene kind={it.slug} lang={lang} />
              </span>
              <span class="adv-sidx__tab">
                <svg class="adv-sidx__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  {shapes(it.icon).map((sh) =>
                    sh.d ? (
                      <path d={sh.d} />
                    ) : sh.circle ? (
                      <circle cx={sh.circle[0]} cy={sh.circle[1]} r={sh.circle[2]} />
                    ) : sh.rect ? (
                      <rect x={sh.rect[0]} y={sh.rect[1]} width={sh.rect[2]} height={sh.rect[3]} rx={sh.rect[4]} />
                    ) : null,
                  )}
                </svg>
              </span>
              <span class="adv-sidx__name">{it.title}</span>
              <span class="adv-sidx__body">
                {it.body}
                <span class="adv-sidx__covers">{it.covers.join(' · ')}</span>
              </span>
              {it.number && (
                <span class="adv-sidx__result">
                  <b class:list={{ 'adv-ph': DEV && it.number.placeholder }}>{loc(it.number.value, lang)}</b>
                  <span>{loc(it.number.short, lang)}</span>
                </span>
              )}
              <span class="adv-sidx__go" aria-hidden="true">
                <Arrow size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  .adv-sidx__title {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .adv-sidx__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 22px);
  }
  .adv-sidx__list > li {
    display: grid;
  }
  .adv-sidx__row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 40px;
    grid-template-areas:
      'preview preview preview'
      'tab name go'
      'body body body'
      'result result result';
    align-items: center;
    gap: 16px 16px;
    padding: 12px 12px clamp(20px, 2vw, 26px);
    border-radius: var(--adv-r-lg);
    color: var(--adv-text);
    text-decoration: none;
    background: var(--adv-card-bg);
    box-shadow: var(--adv-shadow-card);
    transition:
      translate var(--adv-med) var(--adv-ease),
      box-shadow var(--adv-med) var(--adv-ease);
  }
  .adv-sidx__row > :not(.adv-sidx__preview) {
    margin-inline: clamp(8px, 1vw, 14px);
  }
  .adv-sidx__row:hover,
  .adv-sidx__row:focus-visible {
    translate: 0 -4px;
  }
  /* the live preview: a small app window */
  .adv-sidx__preview {
    grid-area: preview;
    position: relative;
    display: block;
    height: clamp(170px, 15vw, 210px);
    padding-top: 26px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.2));
    box-shadow: inset 0 0 0 1px var(--adv-edge);
  }
  .adv-sidx__preview .adv-scene {
    position: absolute;
    inset: 26px 0 0;
    height: auto;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .adv-sidx__dots {
    position: absolute;
    top: 10px;
    left: 12px;
    display: flex;
    gap: 5px;
  }
  .adv-sidx__dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }
  .adv-sidx__tab {
    grid-area: tab;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(180deg, var(--adv-paper), var(--adv-paper-2));
    box-shadow: inset 0 1px 0 #fff;
  }
  .adv-sidx__icon {
    width: 22px;
    height: 22px;
    stroke: var(--adv-ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .adv-sidx__name {
    grid-area: name;
    font-family: var(--adv-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.625rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .adv-sidx__body {
    grid-area: body;
    display: grid;
    gap: 8px;
    color: var(--adv-muted);
    line-height: 1.5;
  }
  .adv-sidx__covers {
    font-size: 0.8125rem;
    color: #7f879b;
  }
  .adv-sidx__result {
    grid-area: result;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--adv-line);
    font-size: 0.8125rem;
    color: var(--adv-muted);
  }
  .adv-sidx__result b {
    font-family: var(--adv-mono);
    font-weight: 500;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-variant-numeric: tabular-nums;
    color: var(--adv-text);
  }
  .adv-sidx__go {
    grid-area: go;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--adv-edge);
    color: var(--adv-foil);
    transition:
      border-color var(--adv-fast) var(--adv-ease),
      color var(--adv-fast) var(--adv-ease);
  }
  .adv-sidx__row:hover .adv-sidx__go {
    border-color: var(--adv-edge-hi);
    color: var(--adv-text);
  }
  .adv-sidx__go .adv-arr {
    transition: translate 250ms var(--adv-ease);
  }
  .adv-sidx__row:hover .adv-arr {
    translate: 2px 0;
  }
  @media (max-width: 860px) {
    .adv-sidx__list {
      grid-template-columns: 1fr;
    }
  }
</style>
