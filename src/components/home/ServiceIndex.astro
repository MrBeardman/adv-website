---
/**
 * Homepage services (Honza, Oct 29 2026): the four services as a 2×2 grid of cards, each a link to its
 * service page. Every card opens with a small live UI preview of the work (ui/Scene.astro, in an app
 * window) like a product screenshot, then what it covers and its one checkable result (homeNumbers.ts).
 * The page light shows through on hover (.adv-lit).
 */
import Arrow from '../ui/Arrow.astro';
import Node from '../ui/Node.astro';
import Scene from '../ui/Scene.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import { pick, loc, type Lang } from '../../i18n';
import services from '../../i18n/services.json';
import { ENABLED_SERVICES } from '../../data/capabilities';
import { numberFor } from '../../data/homeNumbers';
import { routes } from '../../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = pick(services, lang);
const DEV = import.meta.env.DEV;
const items = ENABLED_SERVICES.map((sv) => {
  const copy = s.capabilities.items.find((i) => i.slug === sv.slug)!;
  return {
    slug: sv.slug,
    href: routes.service(lang, sv.slug),
    title: copy.title,
    body: copy.body,
    covers: copy.covers,
    number: numberFor(sv.slug),
  };
});
---

<section class="adv-section adv-sidx" aria-labelledby="adv-sidx-title">
  <div class="adv-wrap">
    <h2 id="adv-sidx-title" class="adv-h2 adv-sidx__title" data-reveal><Node />{s.capabilities.title}</h2>
    <ul class="adv-sidx__list">
      {
        items.map((it, k) => (
          <li data-reveal style={`--i:${k}`}>
            <a class="adv-sidx__row adv-lit" href={it.href}>
              <span class="adv-sidx__preview" aria-hidden="true">
                <span class="adv-sidx__dots">
                  <i />
                  <i />
                  <i />
                </span>
                <Scene kind={it.slug} lang={lang} />
              </span>
              <span class="adv-sidx__tab">
                <ServiceIcon slug={it.slug} tone="fade" />
              </span>
              <span class="adv-sidx__name">{it.title}</span>
              <span class="adv-sidx__body">
                {it.body}
                <span class="adv-sidx__covers">{it.covers.join(' · ')}</span>
              </span>
              {it.number && (
                <span class="adv-sidx__result">
                  {[it.number, ...it.number.more].map((st) => (
                    <span class="adv-sidx__stat">
                      <b class:list={{ 'adv-ph': DEV && st.placeholder }}>{loc(st.value, lang)}</b>
                      <span>{loc(st.short, lang)}</span>
                    </span>
                  ))}
                </span>
              )}
              <span class="adv-sidx__go" aria-hidden="true">
                <Arrow size={18} />
                <Arrow size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  .adv-sidx__title {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .adv-sidx__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 22px);
  }
  .adv-sidx__list > li {
    display: grid;
  }
  .adv-sidx__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'preview preview preview'
      'tab name go'
      'body body body'
      'result result result';
    align-items: center;
    gap: 16px 16px;
    padding: 12px 12px clamp(20px, 2vw, 26px);
    border-radius: var(--adv-r-lg);
    color: var(--adv-text);
    text-decoration: none;
    background: var(--adv-glass-bg);
    -webkit-backdrop-filter: var(--adv-glass-blur);
    backdrop-filter: var(--adv-glass-blur);
    box-shadow: var(--adv-glass-shadow);
    transition:
      translate var(--adv-med) var(--adv-ease),
      box-shadow var(--adv-med) var(--adv-ease);
  }
  /* inner inset for everything below the preview; the tab and the arrow only on their outer side, so their
     auto columns include it and nothing spills past the card edge */
  .adv-sidx__row {
    --in: clamp(8px, 1vw, 14px);
  }
  .adv-sidx__body,
  .adv-sidx__result {
    margin-inline: var(--in);
  }
  .adv-sidx__tab {
    margin-left: var(--in);
  }
  .adv-sidx__go {
    margin-right: var(--in);
  }
  .adv-sidx__row:hover,
  .adv-sidx__row:focus-visible {
    translate: 0 -4px;
  }
  /* the live preview: a small app window */
  .adv-sidx__preview {
    grid-area: preview;
    position: relative;
    display: block;
    height: clamp(170px, 15vw, 210px);
    padding-top: 26px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.2));
    box-shadow: inset 0 0 0 1px var(--adv-edge);
  }
  .adv-sidx__preview .adv-scene {
    position: absolute;
    inset: 26px 0 0;
    height: auto;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .adv-sidx__dots {
    position: absolute;
    top: 10px;
    left: 12px;
    display: flex;
    gap: 5px;
  }
  .adv-sidx__dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }
  .adv-sidx__tab {
    grid-area: tab;
    display: grid;
  }
  .adv-sidx__name {
    grid-area: name;
    font-family: var(--adv-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.625rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .adv-sidx__body {
    grid-area: body;
    display: grid;
    gap: 8px;
    color: var(--adv-muted);
    line-height: 1.5;
  }
  .adv-sidx__covers {
    font-size: 0.8125rem;
    color: #7f879b;
  }
  /* the results: the headline number and two more, side by side */
  .adv-sidx__result {
    grid-area: result;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--adv-line);
  }
  .adv-sidx__stat {
    display: grid;
    align-content: start;
    gap: 4px;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--adv-muted);
  }
  .adv-sidx__stat + .adv-sidx__stat {
    padding-left: 16px;
    border-left: 1px solid var(--adv-line);
  }
  .adv-sidx__stat b {
    font-family: var(--adv-mono);
    font-weight: 500;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--adv-text);
  }
  /* the go button: on hover it fills and the arrow runs through (out right, a new one in from the left),
     always inside the circle */
  .adv-sidx__go {
    grid-area: go;
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    overflow: hidden;
    color: var(--adv-foil);
    box-shadow: inset 0 0 0 1px var(--adv-edge);
    transition:
      background-color 350ms var(--adv-ease),
      color 350ms var(--adv-ease),
      box-shadow 350ms var(--adv-ease);
  }
  .adv-sidx__go .adv-arr {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: translate 450ms var(--adv-ease);
  }
  .adv-sidx__go .adv-arr + .adv-arr {
    translate: -30px 0;
  }
  .adv-sidx__row:hover .adv-sidx__go,
  .adv-sidx__row:focus-visible .adv-sidx__go {
    background-color: var(--adv-paper);
    color: var(--adv-ink);
    box-shadow: inset 0 0 0 1px var(--adv-paper);
  }
  .adv-sidx__row:hover .adv-sidx__go .adv-arr,
  .adv-sidx__row:focus-visible .adv-sidx__go .adv-arr {
    translate: 30px 0;
  }
  .adv-sidx__row:hover .adv-sidx__go .adv-arr + .adv-arr,
  .adv-sidx__row:focus-visible .adv-sidx__go .adv-arr + .adv-arr {
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .adv-sidx__go .adv-arr + .adv-arr {
      display: none;
    }
    .adv-sidx__row:hover .adv-sidx__go .adv-arr {
      translate: 0 0;
    }
  }
  @media (max-width: 860px) {
    .adv-sidx__list {
      grid-template-columns: 1fr;
    }
  }
</style>
