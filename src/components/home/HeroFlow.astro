---
/**
 * Homepage hero (Honza, Oct 29 2026): one singular WebGL element instead of the busy workflow. Scattered
 * points and bits of data float around (a business today), get pulled into the A, and leave as a smooth
 * ribbon of lines (a business that runs): scripts/flow/engine.ts, three.js loaded on demand. Headline, sub and the run
 * action sit over its quiet left side. The hero is the first node of the page's workflow (output port).
 *
 * Reduced motion: one still frame. No WebGL or no JS: the page's own light carries the hero.
 */
import Arrow from '../ui/Arrow.astro';
import Play from '../ui/Play.astro';
import { pick, type Lang } from '../../i18n';
import chrome from '../../i18n/chrome.json';
import home from '../../i18n/home.json';
import { routes } from '../../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = pick(chrome, lang);
const w = pick(home, lang).workflow;
---

<section class="adv-hf" aria-labelledby="adv-hf-title" data-nf>
  <canvas class="adv-hf__canvas" data-hf-canvas aria-hidden="true"></canvas>
  <div class="adv-hf__inner adv-wrap">
    <h1 id="adv-hf-title" class="adv-hf__title">
      <span class="adv-line"><span>{c.hero.headline1}</span></span>
      <span class="adv-line"><span>{c.hero.headline2}</span></span>
    </h1>
    <p class="adv-lead adv-hf__sub" style="--i:2">{c.hero.sub}</p>
    <div class="adv-hf__ctas" style="--i:3">
      <a class="adv-btn adv-btn--primary" href={'#' + w.inquiryId}><Play />{w.run}</a>
      <a class="adv-btn adv-btn--ghost" href={routes.work(lang)}>{c.notFound.work}<Arrow /></a>
    </div>
    <p class="adv-hf__note" style="--i:4">{c.hero.ctaNote}</p>
  </div>
  <span class="adv-nf__port adv-nf__port--out adv-hf__port" data-nf-out aria-hidden="true"></span>
</section>

<script>
  import { canRunWebGL } from '../../scripts/gl';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hf-canvas]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && canRunWebGL()) {
    const count = innerWidth < 760 ? 6000 : 16000;
    // Boot after first paint and a quiet moment: the copy is already on screen (pure CSS entrance), so
    // three.js and the shader compile never sit in front of the first paint or the LCP.
    const boot = () =>
      import('../../scripts/flow/engine').then(async ({ startEngine }) => {
        await startEngine(canvas, { still, count });
        canvas.classList.add('is-on');
      });
    const idle = () =>
      'requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 1200 }) : setTimeout(boot, 300);
    requestAnimationFrame(() => requestAnimationFrame(idle));
  }
</script>

<style is:global>
  .adv-hf {
    position: relative;
    min-height: min(100svh, 980px);
    display: grid;
    align-items: center;
    padding-top: var(--adv-header-h);
    padding-bottom: clamp(56px, 8vw, 110px);
  }
  .adv-hf__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1400ms var(--adv-ease);
  }
  .adv-hf__canvas.is-on {
    opacity: 1;
  }
  .adv-hf__inner {
    position: relative;
  }
  .adv-hf::before {
    /* keep the copy column calm over the stream */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(60% 70% at 18% 52%, rgba(6, 7, 11, 0.7), transparent 70%);
  }
  .adv-hf__canvas {
    z-index: 0;
  }
  .adv-hf__inner {
    z-index: 2;
  }
  /* The entrance is CSS only (no script gate), so the hero copy paints with the first frame. */
  @keyframes adv-hf-in {
    from {
      opacity: 0;
      translate: 0 22px;
      filter: blur(8px);
    }
  }
  @keyframes adv-hf-line {
    from {
      translate: 0 105%;
    }
  }
  .adv-hf__sub,
  .adv-hf__ctas,
  .adv-hf__note {
    animation: adv-hf-in var(--adv-slow) var(--adv-ease) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }
  .js .adv-hf__title .adv-line > span {
    translate: 0 0;
    transition: none;
    animation: adv-hf-line 1000ms var(--adv-ease) both;
  }
  .js .adv-hf__title .adv-line:nth-child(2) > span {
    animation-delay: 110ms;
  }
  .adv-hf__title {
    max-width: 12ch;
    font-size: clamp(3rem, 1.4rem + 5vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .adv-hf__sub {
    margin-top: 28px;
    max-width: 42ch;
  }
  .adv-hf__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .adv-hf__note {
    margin-top: 14px;
    font-size: 0.875rem;
    color: var(--adv-muted);
  }
  .adv-hf__port {
    left: 50%;
    bottom: 18px;
  }
  @media (max-width: 760px) {
    .adv-hf {
      align-items: end;
      min-height: 92svh;
    }
    .adv-hf__canvas {
      height: 62%;
    }
  }
</style>
