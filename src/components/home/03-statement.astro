---
/** Statement: one sentence lit word by word as it scrolls past ("Most of the work is routine."). */
import Node from '../ui/Node.astro';
import { pick, type Lang } from '../../i18n';
import home from '../../i18n/home.json';

interface Props {
  lang: Lang;
  /** kicker number = node on the stream; omit for a plain kicker */
  index?: string;
}
const { lang, index } = Astro.props;
const t = pick(home, lang).statement;
---

<section class="adv-statement adv-section" aria-labelledby="adv-statement-title">
  <div class="adv-wrap">
    <h2 id="adv-statement-title" class="adv-statement__text" data-lit>
      <Node />
      <span class="adv-statement__lead">{t.lead}</span>
      {t.rest}
    </h2>
  </div>
</section>

<style is:global>
  .adv-statement {
    position: relative;
  }
  .adv-statement::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(1100px, 120vw);
    height: 600px;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgba(32, 64, 170, 0.22), transparent 70%);
    pointer-events: none;
  }
  .adv-statement__text {
    position: relative;
    max-width: 22ch;
    font-size: clamp(2.125rem, 1.2rem + 3.6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .adv-statement__lead {
    display: block;
    margin-bottom: 0.1em;
  }
  .adv-statement__lead .adv-w {
    color: rgb(124 200 255 / calc(0.25 + var(--lit, 0) * 0.75));
  }
  @media (prefers-reduced-motion: reduce) {
    .adv-statement__lead .adv-w {
      color: var(--adv-accent);
    }
  }
</style>
