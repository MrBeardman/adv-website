---
/**
 * Automation & AI service page (/sluzby/automatizace/, /en/services/automation/): the Relay-style page.
 * Honza, Oct 2026: this rich page is the automation service, not the company homepage.
 * lab/frameless (Oct 30 2026): like the homepage, the hero's lines drift behind the page as a helix and the
 * cards and panels are frosted glass; the stream of light and its gutter nodes are off. It ends in the CTA panel.
 *
 *   01 hero + live workflow window + workflow grid    06 numbers band
 *   02 tools strip                                    07 savings slider
 *   03 statement (scroll-lit words)                   08 how we work (timeline)
 *   04 what we automate (three scene cards)           09 selected automation work
 *   05 savings that grow                               10 Ice CTA panel with a short form
 * The "V kostce" block (after the tools) and the FAQ (before the CTA) render as plain sections here, not inside
 * `.adv-flow`: 01-hero.astro uses that class name for the wires in its window (aspect-ratio + margin).
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/home/01-hero.astro';
import Tools from '../components/home/02-tools.astro';
import Statement from '../components/home/03-statement.astro';
import Uses from '../components/automation/Uses.astro';
import Growth from '../components/automation/Growth.astro';
import Numbers from '../components/home/06-numbers.astro';
import Savings from '../components/home/07-savings.astro';
import Process from '../components/home/08-process.astro';
import SelectedWork from '../components/SelectedWork.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Plain from '../components/Plain.astro';
import Faq from '../components/Faq.astro';
import { pick, type Lang } from '../i18n';
import automation from '../i18n/automation.json';
import chrome from '../i18n/chrome.json';
import services from '../i18n/services.json';
import geo from '../i18n/geo.json';
import { routes } from '../data/routes';
import { serviceSchema, breadcrumbSchema, SERVICE_TYPES } from '../data/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(automation, lang);
const c = pick(chrome, lang);
const s = pick(services, lang);
const meta = pick(geo, lang).pages['ai-automation'].meta;
const copy = s.capabilities.items.find((i) => i.slug === 'ai-automation')!;
const alternates = { cs: routes.service('cs', 'ai-automation'), en: routes.service('en', 'ai-automation') };
const site = Astro.site!;
const schema = [
  serviceSchema(lang, site, {
    name: copy.title,
    description: meta.description,
    path: alternates[lang],
    serviceType: SERVICE_TYPES['ai-automation'][lang],
  }),
  breadcrumbSchema(site, [
    { name: c.nav.home, path: routes.home(lang) },
    { name: c.nav.services, path: routes.services(lang) },
    { name: copy.title, path: alternates[lang] },
  ]),
];
---

<Base lang={lang} title={meta.title} description={meta.description} alternates={alternates} schema={schema}>
  <Hero
    lang={lang}
    pill={t.hero.pill}
    sub={t.hero.sub}
    headline={[t.hero.headline1, t.hero.headline2]}
    typeWords={t.hero.typeWords}
  />
  <Tools lang={lang} />
  <Plain lang={lang} page="ai-automation" node={false} />
  <Statement lang={lang} />
  <Uses lang={lang} />
  <Growth lang={lang} />
  <Numbers lang={lang} />
  <Savings lang={lang} />
  <Process lang={lang} />
  <SelectedWork lang={lang} service="ai-automation" />
  <Faq lang={lang} page="ai-automation" node={false} />
  <CtaPanel lang={lang} />
</Base>
