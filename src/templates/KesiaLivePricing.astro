<script>
  import { countUp } from '../scripts/count';

  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Hero ticker: a mean-reverting random walk around fixed sample values, one tick every 1.8 s, only while
     on screen. The moving numbers are aria-hidden; a screen reader gets one sentence saying what they are. */
  const ticker = document.querySelector<HTMLElement>('[data-ticker]');
  if (ticker && !RM) {
    const loc = document.documentElement.lang.startsWith('cs') ? 'cs-CZ' : 'en-GB';
    const nf = new Intl.NumberFormat(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const rows = [...ticker.querySelectorAll<HTMLElement>('[data-metal]')].map((li) => ({
      base: Number(li.dataset.base),
      step: Number(li.dataset.step),
      value: Number(li.dataset.base),
      price: li.querySelector<HTMLElement>('[data-price]')!,
      delta: li.querySelector<HTMLElement>('[data-delta]')!,
    }));
    let on = false;
    new IntersectionObserver(([e]) => (on = e.isIntersecting)).observe(ticker);
    setInterval(() => {
      if (!on || document.hidden) return;
      rows.forEach((r) => {
        const move = (Math.random() - 0.5) * 2 * r.step + (r.base - r.value) * 0.25;
        r.value += move;
        const pct = (move / r.value) * 100;
        r.price.textContent = nf.format(r.value);
        r.price.classList.remove('is-tick');
        void r.price.offsetWidth;
        r.price.classList.add('is-tick');
        r.delta.textContent = `${move >= 0 ? '▲ +' : '▼ '}${nf.format(pct)} %`;
        r.delta.classList.toggle('is-up', move >= 0);
        r.delta.classList.toggle('is-down', move < 0);
      });
    }, 1800);
  }

  /* Problem: the count climbs to 328 while the cells fill (the cells are CSS, see .is-playing). */
  const problem = document.querySelector<HTMLElement>('.adv-k__problem');
  const big = problem?.querySelector<HTMLElement>('[data-count]');
  if (problem && big && !RM) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        countUp(big);
      },
      { threshold: 0.35 },
    );
    io.observe(problem);
  }
</script>
