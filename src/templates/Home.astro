---
/**
 * Homepage (CS at /, EN at /en/). One stream of light runs the whole page (scripts/stream.ts); every
 * section after the hero is a node on it, numbered in its kicker, and it ends in the Ice CTA panel.
 *
 *   01 hero + live workflow window      06 numbers band
 *   02 tools strip                      07 savings slider
 *   03 statement (scroll-lit words)     08 how we work (timeline)
 *   04 four value cards with scenes     09 partners
 *   05 Kesia spotlight                  10 final Ice CTA panel with a short form
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/home/01-hero.astro';
import Tools from '../components/home/02-tools.astro';
import Statement from '../components/home/03-statement.astro';
import Values from '../components/home/04-values.astro';
import Kesia from '../components/home/05-kesia.astro';
import Numbers from '../components/home/06-numbers.astro';
import Savings from '../components/home/07-savings.astro';
import Process from '../components/home/08-process.astro';
import Partners from '../components/Partners.astro';
import CtaPanel from '../components/CtaPanel.astro';
import BrandMoment from '../components/ui/BrandMoment.astro';
import { pick, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import { both, routes } from '../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(chrome, lang);
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={both(routes.home)} stream>
  <Hero lang={lang} />
  <Tools lang={lang} />
  <Statement lang={lang} />
  {/* Optional brand-moment image: pass src to show it (see ui/BrandMoment.astro). */}
  <BrandMoment />
  <Values lang={lang} />
  <Kesia lang={lang} />
  <Numbers lang={lang} />
  <Savings lang={lang} />
  <Process lang={lang} />
  <Partners lang={lang} index="09" />
  <CtaPanel lang={lang} index="10" />
</Base>
