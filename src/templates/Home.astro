---
/**
 * Homepage (CS at /, EN at /en/), Honza, Oct 2026 redesign "The Client File": the open client file with the
 * business as one automation workflow (components/home/Workflow.astro); every step links to its service.
 * Below it: selected work, partners, contact. The 3D card stack (CardStack.astro) is no longer used here.
 * The Relay-style page lives at /sluzby/automatizace/ (templates/Automation.astro).
 */
import Base from '../layouts/Base.astro';
import Workflow from '../components/home/Workflow.astro';
import ServiceIndex from '../components/home/ServiceIndex.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Partners from '../components/Partners.astro';
import CtaPanel from '../components/CtaPanel.astro';
import BrandMoment from '../components/ui/BrandMoment.astro';
import { pick, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import { both, routes } from '../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(chrome, lang);
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={both(routes.home)} stream="light">
  <Workflow lang={lang} />
  <ServiceIndex lang={lang} />
  {/* Optional brand-moment image: pass src to show it (see ui/BrandMoment.astro). */}
  <BrandMoment />
  <SelectedWork lang={lang} limit={3} />
  <Partners lang={lang} />
  <CtaPanel lang={lang} />
</Base>
