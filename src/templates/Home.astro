---
/**
 * Homepage (CS at /, EN at /en/), Honza, Oct 2026: the old ADV homepage's 3D card stack, rebuilt in Astro and
 * dressed in the Studio look (components/home/CardStack.astro). Below it: selected work, partners, contact.
 * The four value cards are gone here: the stack is the services overview now.
 * A faint stream of light (one fine strand) runs through the section nodes below the hero.
 * The Relay-style page lives at /sluzby/automatizace/ (templates/Automation.astro).
 */
import Base from '../layouts/Base.astro';
import CardStack from '../components/home/CardStack.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Partners from '../components/Partners.astro';
import CtaPanel from '../components/CtaPanel.astro';
import BrandMoment from '../components/ui/BrandMoment.astro';
import { pick, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import { both, routes } from '../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(chrome, lang);
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={both(routes.home)} stream="light">
  <CardStack lang={lang} />
  {/* Optional brand-moment image: pass src to show it (see ui/BrandMoment.astro). */}
  <BrandMoment />
  <SelectedWork lang={lang} limit={3} />
  <Partners lang={lang} />
  <CtaPanel lang={lang} />
</Base>
