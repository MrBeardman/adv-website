---
/**
 * Homepage (CS at /, EN at /en/), Honza, Oct 2026 redesign "The Client File": the open client file with the
 * business as one automation workflow (components/home/Workflow.astro); every step links to its service.
 * Below it the page is the workflow itself (Honza: "the website is the automation"): every section is a node
 * (ui/NodeFrame.astro) wired to the next one, the light following scroll (scripts/canvas.ts). The 3D card
 * stack (CardStack.astro) is no longer used here.
 * The Relay-style page lives at /sluzby/automatizace/ (templates/Automation.astro).
 */
import Base from '../layouts/Base.astro';
import HeroFlow from '../components/home/HeroFlow.astro';
import Workflow from '../components/home/Workflow.astro';
import ServiceIndex from '../components/home/ServiceIndex.astro';
import Showcase from '../components/home/Showcase.astro';
import Partners from '../components/Partners.astro';
import Inquiry from '../components/inquiry/Inquiry.astro';
import NodeFrame from '../components/ui/NodeFrame.astro';
import { pick, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import home from '../i18n/home.json';
import { both, routes } from '../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(chrome, lang);
const n = pick(home, lang).canvas;
const inquiryId = pick(home, lang).workflow.inquiryId;
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={both(routes.home)}>
  <HeroFlow lang={lang} />
  <div class="adv-flow">
    <NodeFrame {...n.services} icon="racks" side="left">
      <ServiceIndex lang={lang} />
    </NodeFrame>
    <NodeFrame {...n.fit} icon="nodes" side="right">
      <Workflow lang={lang} />
    </NodeFrame>
    <NodeFrame {...n.work} icon="exchange" side="left">
      <Showcase lang={lang} limit={3} />
    </NodeFrame>
    <NodeFrame {...n.partners} icon="shapes" side="right">
      <Partners lang={lang} />
    </NodeFrame>
    <NodeFrame {...n.inquiry} icon="arrowRight" side="full" id={inquiryId} last>
      <div class="adv-section adv-home-inq">
        <div class="adv-wrap">
          <Inquiry lang={lang} />
        </div>
      </div>
    </NodeFrame>
  </div>
</Base>
