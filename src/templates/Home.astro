---
/**
 * Homepage (CS at /, EN at /en/): the calm company-level overview (Honza, Oct 2026). Same palette, finish,
 * background and micro-interactions as the rest, but quieter: no workflow window, only the breathing grid
 * in the hero, and a light stream (one fine strand) through the section nodes.
 *
 *   hero (ADV as a whole, the four services as links)
 *   four value cards → their service pages (automation → the rich page)
 *   selected work · partners · contact (Ice CTA panel)
 *
 * The Relay-style page lives at /sluzby/automatizace/ (templates/Automation.astro).
 */
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Values from '../components/home/04-values.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Partners from '../components/Partners.astro';
import CtaPanel from '../components/CtaPanel.astro';
import BrandMoment from '../components/ui/BrandMoment.astro';
import { pick, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
import { both, routes } from '../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pick(chrome, lang);
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={both(routes.home)} stream="light">
  <HomeHero lang={lang} />
  <Values lang={lang} />
  {/* Optional brand-moment image: pass src to show it (see ui/BrandMoment.astro). */}
  <BrandMoment />
  <SelectedWork lang={lang} limit={3} />
  <Partners lang={lang} />
  <CtaPanel lang={lang} />
</Base>
