---
import Service from '../../templates/Service.astro';
import { GENERIC_SERVICES } from '../../data/capabilities';

/* Rich services (automation) have their own route file next to this one. */
export function getStaticPaths() {
  return GENERIC_SERVICES.map((s) => ({ params: { slug: s.path.cs }, props: { slug: s.slug } }));
}
const { slug } = Astro.props;
---

<Service lang="cs" slug={slug} />
