# Contact form (set these as environment variables in the Hostinger Node.js app; never commit real values).
# Without SMTP_HOST the form runs in "SMTP-less mode": enquiries are stored in SUBMISSIONS_DIR, no mail is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=ADV Innovations web
# TODO (Honza): the inbox that receives enquiries
MAIL_TO=
# SUBMISSIONS_DIR=/home/<user>/adv-submissions

# n8n intake (lib/n8n.ts): inquiries (api/inquiry.ts) and contact messages (api/contact.ts) go to this webhook,
# which stores them and posts them to Telegram. Not set = they are only stored in SUBMISSIONS_DIR.
N8N_INQUIRY_URL=
# Shared secret sent as the X-ADV-Key header (n8n Header Auth credential)
N8N_INQUIRY_KEY=
