# Contact form (set these as environment variables in the Hostinger Node.js app; never commit real values).
# Without SMTP_HOST the form runs in "SMTP-less mode": enquiries are stored in SUBMISSIONS_DIR, no mail is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=ADV Innovations web
# TODO (Honza): the inbox that receives enquiries
MAIL_TO=
# SUBMISSIONS_DIR=/home/<user>/adv-submissions

# n8n intake (lib/n8n.ts): inquiries (api/inquiry.ts) and contact messages (api/contact.ts) go to this webhook,
# which stores them and posts them to Telegram. Not set = they are only stored in SUBMISSIONS_DIR.
N8N_INQUIRY_URL=
# Shared secret sent as the X-ADV-Key header (n8n Header Auth credential)
N8N_INQUIRY_KEY=

# Search engines: indexable by default. PUBLIC_SITE_INDEXABLE=false makes a preview build noindex (robots meta + robots.txt).
# PUBLIC_SITE_INDEXABLE=false

# Inquiry chat (components/chat, api/chat.ts). Claude Haiku asks up to 3 follow-up questions (lib/chatAgent.ts).
# Not set = the chat skips the AI questions and goes straight from contact to the calendar.
ANTHROPIC_API_KEY=
# Most AI calls per day (all visitors together), a guard against a scripted attack running up the bill.
# CHAT_DAILY_CAP=400
# Busy times of the shared ADV Google calendar (lib/slots.ts): an n8n webhook answering { busy: [{ start, end }] },
# asked with the same X-ADV-Key. Not set = only meetings already requested through the chat block a slot.
# N8N_BUSY_URL=
